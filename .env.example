APP_NAME=VillaDonq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTED_URL=http://127.0.0.1

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=villadonq
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/login/google/callback

GOOGLE_MAPS_API_KEY=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# BNC ESolutions API
BNC_ENABLED=false
BNC_BASE_URL=https://servicios.bncenlinea.com:16500
BNC_CLIENT_GUID=
BNC_MASTER_KEY=
BNC_CLIENT_ID=
BNC_ACCOUNT_NUMBER=
BNC_CURRENCY=VES
BNC_DEFAULT_PAYER_BANK_CODE=191
BNC_SW_TEST_OPERATION=false
BNC_TIMEOUT=20
BNC_VERIFY_SSL=true
BNC_VERIFY_ON_REPORT=true
BNC_REQUIRE_REFERENCE=true
BNC_VERIFICATION_MODE=auto
BNC_REQUEST_TTL_DAYS=7
BNC_FORCE_ALL_ACCOUNTS=false
BNC_ACCOUNT_IDS=
BNC_AMOUNT_TOLERANCE=0.01

# Webhook NotificationPush (BNC)
BNC_WEBHOOK_AUTH=api_key
BNC_WEBHOOK_API_KEY=
BNC_WEBHOOK_LOGIN=
BNC_WEBHOOK_PASSWORD=
BNC_WEBHOOK_TOKEN_TTL=3600
